{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bruol-url-shortener",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"R2_S3_HOST": "c474444d09b3b5ffaa19446916ec2af5.r2.cloudflarestorage.com"
	},
	"routes": [
		{
			"pattern": "short.bruol.me",
			"custom_domain": true
		}
	],

  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "LINK_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "c6b008f8b9c84c3cb1eee3da549d8fca"
    }
  ],

  "r2_buckets": [
    {
      "binding": "HTML_ARTIFACTS",
      "bucket_name": "html-plans"
    }
  ]
}
